             Stage::Child(pid) if launch.group.is_some() => {
@@ -2106,5 +2116,16 @@ pub fn run_pipeline(
                     .0
             }
-            Stage::Child(pid) => wait(pid)?,
+            Stage::Child(pid) => {
+                let launched_ns = configure_clock_ns();
